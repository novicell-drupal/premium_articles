{#
/**
 * @file
 * Default theme implementation to display a one-column layout.
 *
 * Available variables:
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}

{% set classes = [
  'layout',
  'layout--article_section',
  'section'
] %}

<section {{ attributes.addClass(classes) }}>
  <div class="container">
    {% if header and header is not empty %}
      <div class="row">
        <div class="layout-builder__section--header">
          {{ header }}
        </div>
      </div>
    {% endif %}
    {% if content.title or content.description or content.list_date or content.article_type or content.article_categories %}
      <div class="row">
        <div class="col-xs-12">
          {% if content.title %}
            <h1>{{ content.title }}</h1>
          {% endif %}
          {% if content.description %}
            <h2>{{ content.description }}</h2>
          {% endif %}
          <hr/>
          {% if content.list_date %}
            {{ content.list_date }} •
          {% endif %}
          {% if content.article_type %}
            {{ content.article_type }} •
          {% endif %}
          {% if content.article_categories %}
            {{ content.article_categories }}
          {% endif %}
        </div>
      </div>
    {% endif %}
    <div class="row">
      <div {{ region_attributes.content.addClass(['col-xs-12 col-md-8', 'layout__region', 'layout__region--first']) }}>
        {{ content.content }}
      </div>
    </div>
  </div>
</section>
