msgid "Premium Articles"
msgstr "Premium Artikler"

msgid "Article functionality of the Drupal Premium distribution."
msgstr "Kerne funktionalitet til Drupal Premium distributionen."

msgid "Article"
msgstr "Artikel"

msgid "Use <em>articles</em> for your articles, news, events and the like."
msgstr "Brug <em>artikler</em> til dine artikler, nyheder, begivenheder og lignende."

msgid "Article filter"
msgstr "Artikel filter"

msgid "Field with filter and display options for articles."
msgstr "Felt med filter og visningsindstillinger til artikler."

msgid "Article type"
msgstr "Artikel type"

msgid "Article types"
msgstr "Artikel typer"

msgid "The available types of articles."
msgstr "De tilgængelige typer af artikler."

msgid "Article category"
msgstr "Artikel kategori"

msgid "Article categories"
msgstr "Artikel kategorier"

msgid "Used to group together related articles."
msgstr "Bruges til at gruppere relaterede artikler."

msgid "Article form"
msgstr "Artikel formular"

msgid "Add article"
msgstr "Tilføj artikel"

msgid "List date"
msgstr "Liste dato"

msgid "List media"
msgstr "Liste media"

msgid "Display of total number of items"
msgstr "Visning af total antal elementer"

msgid "Total display: @show_total"
msgstr "Total visning: @show_total"

msgid "Filtered out of total number of items"
msgstr "Filtrede ud af total antal elements"

msgid "Shown items out of filtered number of items"
msgstr "Vist elementer ud af filtrerede antal elementer"

msgid "Showing @count out of @total"
msgstr "Viser @count ud af @total"

msgid "Find and manage articles."
msgstr "Find og administrér artikler."

msgid "Show articles of this type."
msgstr "Vis artikler af denne type."

msgid "What article types to display. Choose none to display all."
msgstr "Hvilke artikel typer at vise. Vælg ingen for at vise alle."

msgid "What article categories to display. Choose none to display all."
msgstr "Hvilke artikel kategorier at vise. Vælg ingen for at vise alle."

msgid "Allow exposing facets"
msgstr "Tillad valg af facetter"

msgid "Display pager at the bottom."
msgstr "Vis pager i bunden."

msgid "Select the facets that you want to expose to the user."
msgstr "Vælg hvilke facetter du gerne vil give brugere adgang til."

msgid "Categories"
msgstr "Kategorier"

msgid "How many articles to show at once."
msgstr "Hvor mange artikler skal vises på en gang."

msgid "Page size select"
msgstr "Side størrelses valg"

msgid "What criteria to sort articles by."
msgstr "Hvilket kriterie skal artikler sorteres efter."

msgid "Sort select"
msgstr "Sorterings valg"

msgid "A block showing articles with options for filters and pagination."
msgstr "En blok der viser artikler med instillinger til filtre og paginering."

msgid "A block listing a few articles."
msgstr "En blok der lister et par artikler."

msgid "Add article"
msgstr "Tilføj artikel"

msgid "Add article config"
msgstr "Tilføj artikel konfiguration"

msgid "Configure Premium Articles"
msgstr "Konfigurer Premium Artikler"

msgid "Configure premium articles."
msgstr "Konfigurer premium artikler."

msgid "There are no article configurations yet."
msgstr "Der er ingen artikel konfigurationer endnu."

msgid "What fields can be used as facets?"
msgstr "Hvilke felter kan bruges som facetter?"

msgid "What field should be used for sorting?"
msgstr "Hvilket felt skal bruges til sortering?"

msgid "There is no new content types ready for articles."
msgstr "Der er ingen nye indholdstyper der er klar til artikler."

msgid "Are you sure you want to delete the article config %entity_bundle?"
msgstr "Er du sikker på at du vil slette artikel konfigurationen %entity_bundle?"

msgid "Article config %entity_bundle has been deleted."
msgstr "Artikel konfigurationen %entity_bundle er blevet slettet."
