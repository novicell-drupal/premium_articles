msgid "Premium Articles"
msgstr "Kerne funktionalitet til Drupal Premium distributionen."

msgid "Article functionality of the Drupal Premium distribution."
msgstr "Kerne funktionalitet til Drupal Premium distributionen."

msgid "Article filter"
msgstr "Artikel filter"

msgid "Field with filter and display options for articles."
msgstr "Felt med filter og visningsindstillinger til artikler."

msgid "Articles"
msgstr "Artikler"

msgid "Article type"
msgstr "Artikel type"

msgid "Article types"
msgstr "Artikel typer"

msgid "Article category"
msgstr "Artikel kategori"

msgid "Article categories"
msgstr "Artikel kategorier"

msgid "Article form"
msgstr "Artikel formular"

msgid "Add article"
msgstr "Tilføj artikel"

msgid "Find and manage articles."
msgstr "Find og administrér artikler."

msgid "Show articles of this type."
msgstr "Vis artikler af denne type."

msgid "What article types to display. Choose none to display all."
msgstr "Hvilke artikel typer at vise. Vælg ingen for at vise alle."

msgid "What article categories to display. Choose none to display all."
msgstr "Hvilke artikel kategorier at vise. Vælg ingen for at vise alle."

msgid "Allow selecting form elements"
msgstr "Tillad valg af formular elementer"

msgid "Display pager at the bottom."
msgstr "Vis pager i bunden."

msgid "Type filter"
msgstr "Type filter"

msgid "Allow users to filter by article type."
msgstr "Tillad brugere at filtrere via artikel type."

msgid "Category filter"
msgstr "Kategori filter"

msgid "Allow users to filter by category."
msgstr "Tillad brugere at filtrere via artikel kategori."

msgid "Page size select"
msgstr "Side størrelses valg"

msgid "Allow users to select articles per page."
msgstr "Tillad brugere at vælge artikler per side."

msgid "What criteria to sort articles by."
msgstr "Hvilket kriterie skal artikler sorteres efter."

msgid "Sort select"
msgstr "Sorterings valg"

msgid "Allow users to select the sort criteria."
msgstr "Tillad brugere at vælge sorteringskriterie."

msgid "A block showing articles with options for filters and pagination."
msgstr "En blok der viser artikler med instillinger til filtre og paginering."

msgid "A block listing a few articles."
msgstr "En blok der lister et par artikler."
