<?php

/**
 * Implements hook_locale_translation_projects_alter().
 */
function premium_articles_locale_translation_projects_alter(&$projects) {
  $module_handler = \Drupal::service('module_handler');
  $path = $module_handler->getModule('premium_articles')->getPath();
  $projects['premium_articles']['info']['interface translation server pattern'] = $path.'/translations/%language.po';
}
